{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grideval.local/schemas/cyber-message-0.1.json",
  "title": "GridEval v3 cyber message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "message_id",
    "event_time_s",
    "source",
    "target",
    "sequence",
    "type",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "enum": [
        "command",
        "telemetry",
        "acknowledgement"
      ]
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "parent_message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "event_time_s": {
      "type": "number",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": [
        "connect_permit",
        "active_power_setpoint",
        "active_power_limit",
        "reactive_mode",
        "reactive_setpoint",
        "autonomous_curve",
        "terminal_voltage",
        "frequency",
        "active_power",
        "reactive_power",
        "state_of_charge",
        "connection_state",
        "quality",
        "command_status"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "integer",
            "boolean",
            "string",
            "object",
            "array"
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "valid_until_s": {
          "type": "number",
          "minimum": 0
        },
        "quality": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "online",
              "restart",
              "communication_lost",
              "remote_forced",
              "local_forced",
              "over_range",
              "reference_error",
              "rollover",
              "discontinuity",
              "stale",
              "invalid"
            ]
          }
        }
      }
    }
  }
}
