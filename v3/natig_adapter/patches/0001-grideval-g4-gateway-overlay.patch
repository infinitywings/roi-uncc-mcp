+void Dnp3ApplicationNew::DispatchG4Control()
+{
+    if (g4_control_queue.empty()) {
+        g4_dispatch_scheduled = false;
+        return;
+    }
+    const double now = Simulator::Now().GetSeconds();
+    if (now > g4_control_queue.front().deadline_s) {
+        NS_LOG_WARN("Dropped GridEval command after 5-second queue deadline");
+        g4_control_queue.pop_front();
+        Simulator::ScheduleNow(&Dnp3ApplicationNew::DispatchG4Control, this);
+        return;
+    }
+    if (!running || m_p == NULL || m_p->getState() != Station::IDLE) {
+        Simulator::Schedule(MilliSeconds(10),
+                            &Dnp3ApplicationNew::DispatchG4Control, this);
+        return;
+    }
+    G4ControlRequest request = g4_control_queue.front();
+    g4_control_queue.pop_front();
+    send_control_analog(Dnp3ApplicationNew::SELECT_OPERATE,
+                        request.index, request.raw_count);
+    if (g4_control_queue.empty()) {
+        g4_dispatch_scheduled = false;
+    } else {
+        Simulator::Schedule(MilliSeconds(10),
+                            &Dnp3ApplicationNew::DispatchG4Control, this);
+    }
+}
 
