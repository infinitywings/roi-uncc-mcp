+void Dnp3ApplicationNew::changePoint(        DnpAddr_t addr, DnpIndex_t index,
+					     PointType_t    pointType,
+					     int value, DnpTime_t timestamp)
+{
+    if (!m_isMaster || addr != 4 || pointType != EventInterface::BI ||
+        index > 1 || (value != 0 && value != 1)) {
+        return;
+    }
+    g4_binary[index] = value;
+    g4_binary_seen[index] = true;
+
+    EmitG4TelemetryIfComplete();
+}
+
+void Dnp3ApplicationNew::EmitG4TelemetryIfComplete()
+{
+    bool complete = true;
+    for (int i = 0; i < 4; ++i) {
+        complete = complete && g4_analog_seen[i];
+    }
+    for (int i = 0; i < 2; ++i) {
+        complete = complete && g4_binary_seen[i];
+    }
+    if (!complete) {
+        return;
+    }
+
+    Json::Value root(Json::objectValue);
+    root["wire_schema"] = "grideval-g4-dnp3-telemetry-decoded/1.0";
+    root["master_address"] = 1;
+    root["outstation_address"] = 4;
+    root["received_time_s"] = Simulator::Now().GetSeconds();
+    root["analog_g30v5"] = Json::Value(Json::arrayValue);
+    root["binary_g1v2"] = Json::Value(Json::arrayValue);
+    for (int i = 0; i < 4; ++i) {
+        root["analog_g30v5"].append(g4_analog[i]);
+        g4_analog_seen[i] = false;
+    }
+    for (int i = 0; i < 2; ++i) {
+        root["binary_g1v2"].append(g4_binary[i] != 0);
+        g4_binary_seen[i] = false;
+    }
+    Json::FastWriter writer;
+    auto msg = std::make_unique<helics::Message>();
+    msg->data = writer.write(root);
+    msg->dest = "controller/der_ev4";
+    msg->time = helics::Time::epsilon();
+    DoRead(std::move(msg));
+}
+
+void Dnp3ApplicationNew::changeFloatPoint(DnpAddr_t addr,
+                                          DnpIndex_t index,
+                                          PointType_t pointType,
+                                          float value,
+                                          DnpTime_t timestamp)
+{
+    if (!m_isMaster || addr != 4 || pointType != EventInterface::AI ||
+        index > 3 || !std::isfinite(value)) {
+        return;
+    }
+    g4_analog[index] = value;
+    g4_analog_seen[index] = true;
+    EmitG4TelemetryIfComplete();
+}
