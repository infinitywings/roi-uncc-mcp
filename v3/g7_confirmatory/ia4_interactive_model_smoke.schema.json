{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grideval.local/schemas/g7-m6-interactive-model-smoke-v1.json",
  "title": "GridEval G7 M6 bounded interactive model smoke",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "protocol_id",
    "project_id",
    "mission_id",
    "spec_file_sha256",
    "endpoint",
    "expected_model_id",
    "scope",
    "development_only",
    "campaign_authorized",
    "evaluation_sealed",
    "model_transport_authorized",
    "tool_execution_authorized",
    "simulator_access_authorized",
    "detector_access_authorized",
    "embedding_access_authorized",
    "overlay",
    "status",
    "error",
    "network_requests",
    "completion_requests",
    "model_record",
    "requests",
    "completions",
    "injected_tool_result",
    "session_receipt",
    "tool_execution_used",
    "simulator_accessed",
    "detector_accessed",
    "embedding_accessed"
  ],
  "properties": {
    "schema_version": {
      "const": "grideval-g7-ia4-interactive-model-smoke/v1"
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "project_id": {"const": "prj_01KYMPK10PE9YH1TJ84PAVB9Z6"},
    "mission_id": {"const": "mis_01KYMRDZHYN4QXC1XFTGP54E36"},
    "spec_file_sha256": {"$ref": "#/$defs/sha256"},
    "endpoint": {"type": "string", "minLength": 1},
    "expected_model_id": {"const": "qwen3.6-35b-a3b"},
    "scope": {
      "const": "synthetic_read_only_fixture_interactive_model_qualification"
    },
    "development_only": {"const": true},
    "campaign_authorized": {"const": false},
    "evaluation_sealed": {"const": true},
    "model_transport_authorized": {"const": true},
    "tool_execution_authorized": {"const": false},
    "simulator_access_authorized": {"const": false},
    "detector_access_authorized": {"const": false},
    "embedding_access_authorized": {"const": false},
    "overlay": {"$ref": "#/$defs/overlay"},
    "status": {"enum": ["passed", "failed_closed"]},
    "error": {"type": ["string", "null"]},
    "network_requests": {"type": "integer", "minimum": 0, "maximum": 3},
    "completion_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "model_record": {"type": ["object", "null"]},
    "requests": {
      "type": "array",
      "maxItems": 2,
      "items": {"type": "object"}
    },
    "completions": {
      "type": "array",
      "maxItems": 2,
      "items": {"type": "object"}
    },
    "injected_tool_result": {"type": ["object", "null"]},
    "session_receipt": {"type": ["object", "null"]},
    "tool_execution_used": {"const": false},
    "simulator_accessed": {"const": false},
    "detector_accessed": {"const": false},
    "embedding_accessed": {"const": false}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "overlay_id",
        "development_only",
        "campaign_authorized",
        "evaluation_sealed",
        "base_protocol_id",
        "base_protocol_model_transport_authorized",
        "overlay_model_transport_authorized",
        "tool_execution_authorized",
        "fixture_injection_authorized",
        "simulator_access_authorized",
        "detector_access_authorized",
        "embedding_access_authorized",
        "model_id",
        "development_seeds",
        "temperature",
        "max_tokens_per_turn",
        "timeout_s",
        "network_request_cap",
        "completion_request_cap",
        "turn_policy",
        "failure_policy"
      ],
      "properties": {
        "schema_version": {
          "const": "grideval-g7-ia4-interactive-model-overlay/v1"
        },
        "overlay_id": {
          "type": "string",
          "pattern": "^m6overlay_[0-9a-f]{64}$"
        },
        "development_only": {"const": true},
        "campaign_authorized": {"const": false},
        "evaluation_sealed": {"const": true},
        "base_protocol_id": {
          "type": "string",
          "pattern": "^m5proto_[0-9a-f]{64}$"
        },
        "base_protocol_model_transport_authorized": {"const": false},
        "overlay_model_transport_authorized": {"const": true},
        "tool_execution_authorized": {"const": false},
        "fixture_injection_authorized": {"const": true},
        "simulator_access_authorized": {"const": false},
        "detector_access_authorized": {"const": false},
        "embedding_access_authorized": {"const": false},
        "model_id": {"const": "qwen3.6-35b-a3b"},
        "development_seeds": {"const": [8101, 8102]},
        "temperature": {"const": 0.0},
        "max_tokens_per_turn": {"const": 512},
        "timeout_s": {"type": "number", "exclusiveMinimum": 0,
                       "maximum": 180},
        "network_request_cap": {"const": 3},
        "completion_request_cap": {"const": 2},
        "tool_call_id": {"const": "call_observe_model_0001"},
        "turn_policy": {"type": "array", "minItems": 3, "maxItems": 3},
        "failure_policy": {
          "const": "no_retry_preserve_receipt_fail_closed"
        }
      }
    }
  }
}
