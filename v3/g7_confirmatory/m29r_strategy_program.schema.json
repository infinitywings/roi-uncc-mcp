{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grideval.local/schemas/m29r_strategy_program.schema.json",
  "title": "GridEval M29-R StrategyProgram",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "condition_id",
    "strategy_id",
    "effect_direction",
    "allowed_targets",
    "forbidden_windows",
    "objective_weights",
    "max_total_energy",
    "max_total_visibility",
    "min_actions",
    "max_actions",
    "max_level_delta",
    "cooldown_same_target",
    "required_evidence_ids",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "grideval-g7-m29r-strategy-program/v1"
    },
    "condition_id": {
      "type": "string",
      "pattern": "^m29r_[a-z0-9_]+_(left|right)$"
    },
    "strategy_id": {
      "enum": [
        "gradual_bias",
        "delayed_shift",
        "persistent_pressure",
        "resource_conserving"
      ]
    },
    "effect_direction": {
      "enum": [
        "increase",
        "decrease"
      ]
    },
    "allowed_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DER_A",
          "DER_B",
          "DER_C"
        ]
      }
    },
    "forbidden_windows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "w0",
          "w1",
          "w2",
          "w3"
        ]
      }
    },
    "objective_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "persistence",
        "energy",
        "visibility"
      ],
      "properties": {
        "effect": {"type": "number", "minimum": 0, "maximum": 10},
        "persistence": {"type": "number", "minimum": 0, "maximum": 10},
        "energy": {"type": "number", "minimum": 0, "maximum": 10},
        "visibility": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "max_total_energy": {"type": "integer", "minimum": 0, "maximum": 16},
    "max_total_visibility": {"type": "integer", "minimum": 0, "maximum": 16},
    "min_actions": {"type": "integer", "minimum": 0, "maximum": 4},
    "max_actions": {"type": "integer", "minimum": 0, "maximum": 4},
    "max_level_delta": {"type": "integer", "minimum": 0, "maximum": 4},
    "cooldown_same_target": {"type": "boolean"},
    "required_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"}
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_bundle_id",
        "semantic_meaning_digest",
        "compiler_id"
      ],
      "properties": {
        "evidence_bundle_id": {"type": "string", "pattern": "^m29revidence_[0-9a-f]{64}$"},
        "semantic_meaning_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiler_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
