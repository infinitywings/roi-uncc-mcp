{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grideval.local/schemas/m29s_strategy_program.schema.json",
  "title": "GridEval M29-S StrategyProgram",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "condition_id",
    "strategy_id",
    "effect_direction",
    "allowed_targets",
    "forbidden_windows",
    "objective_weights",
    "max_total_energy",
    "max_total_visibility",
    "min_actions",
    "max_actions",
    "max_level_delta",
    "cooldown_same_target",
    "required_evidence_ids",
    "visible_input_digest",
    "compiler_id"
  ],
  "properties": {
    "schema_version": {
      "const": "grideval-g7-m29s-strategy-program/v1"
    },
    "condition_id": {
      "type": "string",
      "pattern": "^m29s_(development|held_out)_[a-z0-9_]+_(left|right)$"
    },
    "strategy_id": {
      "enum": [
        "gradual_bias",
        "delayed_shift",
        "persistent_pressure",
        "resource_conserving"
      ]
    },
    "effect_direction": {
      "enum": [
        "increase",
        "decrease"
      ]
    },
    "allowed_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "GRID_NORTH_A",
          "GRID_SOUTH_B",
          "GRID_EAST_C",
          "GRID_WEST_D"
        ]
      }
    },
    "forbidden_windows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "t0",
          "t1",
          "t2",
          "t3"
        ]
      }
    },
    "objective_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "persistence",
        "energy",
        "visibility"
      ],
      "properties": {
        "effect": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "persistence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "energy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "visibility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "max_total_energy": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "max_total_visibility": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "min_actions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "max_actions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "max_level_delta": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "cooldown_same_target": {
      "type": "boolean"
    },
    "required_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(m29s_ev|m29s_doc)_[a-zA-Z0-9_]+$"
      }
    },
    "visible_input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiler_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
