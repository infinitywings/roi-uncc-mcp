{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grideval.local/schemas/m29_attack_state.schema.json",
  "title": "GridEval M29-A capability-filtered runtime attack state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "condition_id",
    "knowledge_profile",
    "canonical_facts",
    "semantic_digest",
    "strategies",
    "validity_domains",
    "failure_events",
    "decision_lineage",
    "governance_separation",
    "development_only",
    "evaluation_sealed"
  ],
  "properties": {
    "schema_version": {
      "const": "grideval-g7-m29-attack-state/v1"
    },
    "state_id": {
      "type": "string",
      "pattern": "^m29state_[0-9a-f]{64}$"
    },
    "condition_id": {
      "type": "string",
      "pattern": "^m29_[a-z0-9_]+_(left|right)$"
    },
    "knowledge_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid", "detector", "training_data", "defense", "feedback"],
      "properties": {
        "grid": {"enum": ["none", "partial", "exact"]},
        "detector": {"enum": ["none", "partial", "exact"]},
        "training_data": {"enum": ["none", "partial", "exact"]},
        "defense": {"enum": ["none", "partial", "exact"]},
        "feedback": {"enum": ["none", "partial", "exact"]}
      }
    },
    "canonical_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "subject",
          "predicate",
          "object",
          "information_axis",
          "information_level",
          "evidence_lane",
          "valid_from_window",
          "valid_through_window",
          "evidence_id"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^fact_[a-z0-9_]+$"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "predicate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "information_axis": {
            "enum": ["grid", "detector", "training_data", "defense", "feedback"]
          },
          "information_level": {
            "enum": ["partial", "exact"]
          },
          "evidence_lane": {
            "enum": ["EVIDENCE_VALID", "OUT_OF_SCOPE_EXPLORATORY"]
          },
          "valid_from_window": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "valid_through_window": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^fixture_[a-z0-9_]+$"
          }
        }
      }
    },
    "semantic_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strategies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy_id",
          "applicability",
          "required_tool",
          "failure_modes",
          "validity_domain_ids"
        ],
        "properties": {
          "strategy_id": {
            "enum": ["active_step", "reactive_shift", "low_energy_ramp"]
          },
          "applicability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "required_tool": {
            "type": ["string", "null"],
            "enum": [null, "m29_grid_search_v1"]
          },
          "failure_modes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "validity_domain_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    },
    "validity_domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["validity_domain_id", "operating_point_ids", "status", "evidence_lane"],
        "properties": {
          "validity_domain_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "operating_point_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "status": {
            "enum": ["valid", "invalid", "unknown"]
          },
          "evidence_lane": {
            "enum": ["EVIDENCE_VALID", "OUT_OF_SCOPE_EXPLORATORY"]
          }
        }
      }
    },
    "failure_events": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failure_id", "failure_class", "component", "terminal"],
        "properties": {
          "failure_id": {
            "type": "string",
            "pattern": "^failure_[a-z0-9_]+$"
          },
          "failure_class": {
            "enum": [
              "NO_FEASIBLE_CANDIDATE",
              "INVALID_REQUEST",
              "TOOL_TIMEOUT",
              "TOOL_SCHEMA_ERROR",
              "TOOL_UNAVAILABLE",
              "STRATEGY_RULE_CONTRADICTION"
            ]
          },
          "component": {
            "enum": ["strategy", "optimizer", "validator", "feedback"]
          },
          "terminal": {
            "type": "boolean"
          }
        }
      }
    },
    "decision_lineage": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "window", "input_digest", "outcome"],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^m29decision_[0-9a-f]{64}$"
          },
          "window": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "input_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "outcome": {
            "enum": ["accepted", "refused", "rejected", "failed"]
          }
        }
      }
    },
    "governance_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rka_exposed", "allowed_source_classes"],
      "properties": {
        "rka_exposed": {"const": false},
        "allowed_source_classes": {
          "const": ["development_fixture", "qualified_runtime_receipt"]
        }
      }
    },
    "development_only": {"const": true},
    "evaluation_sealed": {"const": true}
  }
}
