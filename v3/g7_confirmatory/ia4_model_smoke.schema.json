{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grideval.local/schemas/g7-ia4-model-smoke-v1.json",
  "title": "GridEval G7 bounded IA4 model-output parsing smoke",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "protocol_id",
    "project_id",
    "mission_id",
    "spec_file_sha256",
    "endpoint",
    "expected_model_id",
    "search_surface_id",
    "scope",
    "development_only",
    "campaign_authorized",
    "evaluation_sealed",
    "tool_execution_authorized",
    "simulator_accessed",
    "detector_accessed",
    "embedding_accessed",
    "status",
    "network_requests",
    "completion_requests",
    "model_record",
    "request",
    "replay"
  ],
  "properties": {
    "schema_version": {"const": "grideval-g7-ia4-model-smoke/v1"},
    "created_at_utc": {"type": "string", "minLength": 1},
    "protocol_id": {"const": "g7-confirmatory-20260831-r1"},
    "project_id": {"const": "prj_01KYMPK10PE9YH1TJ84PAVB9Z6"},
    "mission_id": {"const": "mis_01KYMRDZHYN4QXC1XFTGP54E36"},
    "spec_file_sha256": {"$ref": "#/$defs/sha256"},
    "endpoint": {"type": "string", "minLength": 1},
    "expected_model_id": {"type": "string", "minLength": 1},
    "search_surface_id": {
      "type": "string",
      "pattern": "^surface_[0-9a-f]{64}$"
    },
    "scope": {"const": "synthetic_interface_model_output_parsing_only"},
    "development_only": {"const": true},
    "campaign_authorized": {"const": false},
    "evaluation_sealed": {"const": true},
    "tool_execution_authorized": {"const": false},
    "simulator_accessed": {"const": false},
    "detector_accessed": {"const": false},
    "embedding_accessed": {"const": false},
    "status": {"const": "passed"},
    "network_requests": {"const": 2},
    "completion_requests": {"const": 1},
    "model_record": {"type": "object"},
    "request": {"type": "object"},
    "replay": {"$ref": "ia4_model_replay.schema.json"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
