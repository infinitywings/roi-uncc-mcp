# =====================================================================
# GridEval v3 (NATIG + OpenDER) — reorg 2026-08: pin+reproduce, never vendor
# =====================================================================
# Upstream source clones & virtualenvs (fetched via v3/deps/fetch_deps.sh)
v3/deps/natig-src/
v3/deps/opender-src/
v3/deps/opender-venv/
**/.git/

