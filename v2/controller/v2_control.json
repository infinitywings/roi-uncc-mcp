{
  "coreInit": "--federates=1",
  "coreName": "EVController_v2_Core",
  "coreType": "zmq",
  "broker": "tcp://localhost:23404",
  "name": "EV_Controller_v2",
  "period": 60,
  "log_level": "warning",

  "subscriptions": [
    {
      "global": true,
      "key": "gld_hlc_conn/Sa",
      "type": "complex",
      "unit": "VA",
      "info": {"object": "Node650", "property": "measured_power_A"}
    },
    {
      "global": true,
      "key": "gld_hlc_conn/Sb",
      "type": "complex",
      "unit": "VA",
      "info": {"object": "Node650", "property": "measured_power_B"}
    },
    {
      "global": true,
      "key": "gld_hlc_conn/Sc",
      "type": "complex",
      "unit": "VA",
      "info": {"object": "Node650", "property": "measured_power_C"}
    }
  ],

  "endpoints": [
    {"key": "EV_Controller/EV1", "destination": "gld_hlc_conn/EV1", "global": true, "type": "string"},
    {"key": "EV_Controller/EV2", "destination": "gld_hlc_conn/EV2", "global": true, "type": "string"},
    {"key": "EV_Controller/EV3", "destination": "gld_hlc_conn/EV3", "global": true, "type": "string"},
    {"key": "EV_Controller/EV4", "destination": "gld_hlc_conn/EV4", "global": true, "type": "string"},
    {"key": "EV_Controller/EV5", "destination": "gld_hlc_conn/EV5", "global": true, "type": "string"},
    {"key": "EV_Controller/EV6", "destination": "gld_hlc_conn/EV6", "global": true, "type": "string"}
  ],

  "publications": [
    {"global": true, "key": "swEV1_storage", "type": "string"},
    {"global": true, "key": "swEV1", "type": "string"},
    {"global": true, "key": "swEV4_storage", "type": "string"},
    {"global": true, "key": "swEV4", "type": "string"}
  ],

  "filters": []
}
